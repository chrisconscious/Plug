{
  "name": "plug-backend",
  "version": "0.2.0",
  "private": true,
  "description": "PLUG production-oriented API backend (Next.js App Router, TypeScript) with a PostgreSQL data layer.",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "check:openapi-drift": "node scripts/check-openapi-drift.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx db/scripts/migrate.ts",
    "db:seed": "psql \"$DATABASE_URL\" -f db/seed.sql",
    "db:seed:catalog": "node db/scripts/seed-catalog.cjs",
    "db:create-super-admin": "tsx db/scripts/create-super-admin.ts",
    "media:cleanup-orphans": "tsx db/scripts/cleanup-orphaned-media.ts"
  },
  "dependencies": {
    "next": "^14.2.5",
    "pg": "^8.12.0",
    "@aws-sdk/client-s3": "^3.687.0",
    "ioredis": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
