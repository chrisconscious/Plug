# PLUG frontend -> backend API configuration (Vite)
# Point at the Next.js backend (../api). The backend writes
# auth tokens to httpOnly cookies, so the client sends `credentials: 'include'`
# on every request — see src/lib/api.ts.
#
# Contains no secrets: this is a public base URL the browser itself uses,
# not a credential. Still kept out of git (see root .gitignore) for the
# normal reason of letting each environment (dev/staging/prod) set its own
# value without editing tracked files.
VITE_API_BASE_URL=http://localhost:3001
